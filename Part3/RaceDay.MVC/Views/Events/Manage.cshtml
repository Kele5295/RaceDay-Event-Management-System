@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage events";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">My events</h1>
        <p class="text-muted mb-0">
            Create and manage your RaceDay events.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        Create event
    </a>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have not created any events yet.
        Select Create event to get started.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.EventName</td>
                        <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Location</td>
                        <td>@item.Distance.ToString("0.##") km</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Delete this event? Events with enrolments cannot be deleted.');">
                                    <input type="hidden"
                                           name="id"
                                           value="@item.EventID" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}