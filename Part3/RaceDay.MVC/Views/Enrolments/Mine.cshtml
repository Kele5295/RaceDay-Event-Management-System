@model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My events";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>My events</h1>
        <p class="text-muted mb-0">
            View and manage your RaceDay entries.
        </p>
    </div>

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-success">
        Explore events
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have not entered any events yet.
        <a asp-controller="Events" asp-action="Index">
            Find an event
        </a>
        to get started.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var entry in Model)
                {
                    var badgeClass = entry.Status switch
                    {
                        "Confirmed" => "bg-success",
                        "Pending" => "bg-warning text-dark",
                        "Cancelled" => "bg-secondary",
                        _ => "bg-info text-dark"
                    };

                    <tr>
                        <td>@entry.EventName</td>
                        <td>@entry.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@entry.CategoryName</td>
                        <td>
                            <span class="badge @badgeClass">
                                @entry.Status
                            </span>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@entry.EventID"
                                   class="btn btn-outline-secondary btn-sm">
                                    View event
                                </a>

                                @if (entry.Status != "Cancelled")
                                {
                                    <form asp-controller="Enrolments"
                                          asp-action="Cancel"
                                          method="post"
                                          onsubmit="return confirm('Cancel this entry? You will not be able to enter this event again using this account.');">

                                        <input type="hidden"
                                               name="id"
                                               value="@entry.EnrolmentID" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">
                                            Cancel entry
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}