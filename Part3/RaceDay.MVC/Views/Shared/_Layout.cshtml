@using Microsoft.AspNetCore.Http

@{
    var userId = Context.Session.GetInt32("UserID");
    var role = Context.Session.GetString("Role");
    var displayName = Context.Session.GetString("DisplayName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDay.MVC.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    RaceDay
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Index">
                                Explore events
                            </a>
                        </li>

                        @if (userId.HasValue && role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Events"
                                   asp-action="Manage">
                                    My events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Events"
                                   asp-action="Create">
                                    Create event
                                </a>
                            </li>
                        }

                        @if (userId.HasValue && role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Enrolments"
                                   asp-action="Mine">
                                    My events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Results"
                                   asp-action="Mine">
                                    My results
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (userId.HasValue)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    My profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <span class="navbar-text">
                                    @displayName
                                    <span class="badge bg-success">
                                        @role
                                    </span>
                                </span>
                            </li>

                            <li class="nav-item my-2 my-lg-0">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm">
                                        Log out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Log in
                                </a>
                            </li>

                            <li class="nav-item my-2 my-lg-0">
                                <a class="btn btn-success"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-5">
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger" role="alert">
                    @error
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3 mt-auto">
        <div class="container">
            &copy; @DateTime.Now.Year RaceDay &middot; Run. Walk. Cycle.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>